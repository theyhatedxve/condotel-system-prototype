DATABASE_URL=file:./prisma/dev.db
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_EXPIRES_IN_SECONDS=3600

# Set separate random secrets locally; never commit their values.
JWT_SECRET=

# Canonical Base64 encoding of 32 random bytes, backend only.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Put the result in backend/.env. Changing the key invalidates previous ciphertext.
AES_MASTER_KEY=
