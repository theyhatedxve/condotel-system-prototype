DATABASE_URL=file:./prisma/dev.db
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_EXPIRES_IN_SECONDS=3600

# Set separate random secrets locally; never commit their values.
JWT_SECRET=

# Canonical Base64 encoding of 32 random bytes, backend only.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Put the result in backend/.env. Changing the key invalidates previous ciphertext.
AES_MASTER_KEY=

# Independent canonical Base64 encoding of 32 random bytes. Do not reuse AES_MASTER_KEY.
# Domain-separated HMAC indexes protect email and phone exact lookup.
CONTACT_SEARCH_KEY=

# PayMongo server secrets; leave blank until configuring checkout and a signed webhook.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash

# Rotation only: provide NEXT_AES_MASTER_KEY and NEXT_CONTACT_SEARCH_KEY through
# the offline process environment. Preserve old keys with backups; see ../PRIVACY.md.
